{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aria",
  "version": "0.4.1",
  "identifier": "com.5060solutions.aria",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aria",
        "width": 420,
        "height": 720,
        "minWidth": 380,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "5060 Solutions",
    "copyright": "\u00a9 2024-2026 5060 Solutions. All rights reserved.",
    "category": "SocialNetworking",
    "shortDescription": "Modern open-source VoIP softphone",
    "longDescription": "Aria is a beautiful, modern softphone built from the ground up with Rust and React. Crystal-clear HD audio, secure TLS encryption, multi-account support, and built-in call recording. Free for personal use.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "certificateThumbprint": null,
      "timestampUrl": "http://timestamp.digicert.com",
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ],
        "section": "comm"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "tel",
          "sip",
          "aria"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0Mjg2Qjk2MTRGRTE4QjQKUldTMEdQNFVsbXNvbE5Cem80TnhsVmJBUWtFYjRyZTV5Q2Z3bTR2N0hZRklFVnJrWlluaVRtQkkK",
      "endpoints": [
        "https://github.com/5060-Solutions/aria/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
